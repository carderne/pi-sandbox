{
  "name": "pi-sandbox",
  "version": "0.6.8",
  "description": "OS-level sandboxing for pi with interactive permission prompts",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carderne/pi-sandbox.git"
  },
  "author": "Chris Arderne <chris@rdrn.me>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/carderne/pi-sandbox/issues"
  },
  "homepage": "https://github.com/carderne/pi-sandbox",
  "scripts": {
    "fmt": "oxfmt index.ts src test scripts",
    "lint": "oxlint index.ts src test scripts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "build:sandbox": "tsx scripts/build-sandbox.ts",
    "test:linux-launcher": "PI_SANDBOX_NATIVE_TEST=1 tsx --test test/linux-launcher.test.ts",
    "test:linux-integration": "tsx scripts/build-sandbox.ts && PI_SANDBOX_NATIVE_TEST=1 tsx --test test/linux-runtime.test.ts test/linux-relay.test.ts test/linux-pi-loader.test.ts test/session-isolation.test.ts",
    "all": "pnpm run fmt && pnpm run lint && pnpm run check && pnpm test",
    "ci:fmt": "oxfmt --check index.ts src test scripts",
    "ci:lint": "pnpm run lint",
    "ci:check": "pnpm run check",
    "ci:test": "pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.0",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.0",
    "@earendil-works/pi-tui": "^0.80.0",
    "@types/node": "^24",
    "@types/node-forge": "1.3.14",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.1",
      "lodash-es": ">=4.18.1"
    }
  },
  "dependencies": {
    "@pondwader/socks5-server": "1.0.10",
    "commander": "12.1.0",
    "node-forge": "1.4.0",
    "zod": "3.25.76"
  }
}
