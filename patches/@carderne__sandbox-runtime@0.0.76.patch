index 9f57df50e60288c5603476ff9936815b88450821..9c2e4be5a319422d36768ecedd444a15da914a44 100644
--- a/dist/sandbox/linux-sandbox-utils.js
+++ b/dist/sandbox/linux-sandbox-utils.js
@@ -1225,6 +1225,41 @@ export async function wrapCommandWithSandboxLinux(params) {
         bwrapArgs.push(...fsArgs);
         // Always bind /dev
         bwrapArgs.push('--dev', '/dev');
+        // Opt-in serial access only; never bind the whole host /dev or raw USB.
+        if (params.allowSerialDevices === true) {
+            const serialNodes = new Set();
+            for (const name of fs.readdirSync('/dev')) {
+                if (!/^tty(?:ACM|USB)\d+$/.test(name)) continue;
+                const device = `/dev/${name}`;
+                try {
+                    if (!fs.lstatSync(device).isCharacterDevice()) continue;
+                } catch (error) {
+                    if (error.code === 'ENOENT') continue;
+                    throw error;
+                }
+                serialNodes.add(device);
+                bwrapArgs.push('--dev-bind-try', device, device);
+            }
+            for (const directory of ['/dev/serial/by-id', '/dev/serial/by-path']) {
+                let entries;
+                try { entries = fs.readdirSync(directory); }
+                catch (error) {
+                    if (error.code === 'ENOENT') continue;
+                    throw error;
+                }
+                for (const name of entries) {
+                    const link = join(directory, name);
+                    try {
+                        if (!fs.lstatSync(link).isSymbolicLink()) continue;
+                        const target = fs.realpathSync(link);
+                        if (serialNodes.has(target)) bwrapArgs.push('--symlink', target, link);
+                    } catch (error) {
+                        if (error.code === 'ENOENT') continue;
+                        throw error;
+                    }
+                }
+            }
+        }
         // ========== PID NAMESPACE ISOLATION ==========
         // IMPORTANT: These must come AFTER filesystem binds for nested bwrap to work
         // By default, always unshare PID namespace and mount fresh /proc.
